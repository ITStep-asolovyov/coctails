<?xml version="1.0" encoding="utf-8"?>
<!--
    Cocktail glass icon — foreground layer for adaptive icon.
    Safe zone: 66dp centred in 108dp canvas. Paths drawn at 108×108.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Gold glow circle behind the glass -->
    <path
        android:pathData="M54,54 m-24,0 a24,24 0 1,0 48,0 a24,24 0 1,0 -48,0"
        android:fillColor="#1AD4AF37" />

    <!-- Martini glass bowl (trapezoid) -->
    <path
        android:pathData="M30,28 L78,28 L59,58 L49,58 Z"
        android:fillColor="#D4AF37"
        android:strokeColor="#F4E5B2"
        android:strokeWidth="1.5" />

    <!-- Glass stem -->
    <path
        android:pathData="M54,58 L54,74"
        android:strokeColor="#D4AF37"
        android:strokeWidth="3"
        android:strokeLineCap="round" />

    <!-- Glass base -->
    <path
        android:pathData="M44,74 L64,74"
        android:strokeColor="#D4AF37"
        android:strokeWidth="3"
        android:strokeLineCap="round" />

    <!-- Cocktail fill inside bowl (olive/drink colour) -->
    <path
        android:pathData="M35,34 L73,34 L59,58 L49,58 Z"
        android:fillColor="#B87333"
        android:fillAlpha="0.55" />

    <!-- Rim highlight -->
    <path
        android:pathData="M30,28 L78,28"
        android:strokeColor="#F4E5B2"
        android:strokeWidth="2"
        android:strokeLineCap="round" />

    <!-- Olive on a cocktail pick -->
    <path
        android:pathData="M54,34 L54,46"
        android:strokeColor="#F4E5B2"
        android:strokeWidth="1.2"
        android:strokeLineCap="round" />
    <path
        android:pathData="M54,46 m-4,0 a4,4 0 1,0 8,0 a4,4 0 1,0 -8,0"
        android:fillColor="#27AE60" />
    <!-- Olive centre dot -->
    <path
        android:pathData="M54,46 m-1.5,0 a1.5,1.5 0 1,0 3,0 a1.5,1.5 0 1,0 -3,0"
        android:fillColor="#F4E5B2" />

</vector>
